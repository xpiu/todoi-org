# Copy to .env for local development. Never commit .env.
PORT=3001
# The public origin, used for canonical URLs, JSON-LD and the sitemap.
SITE_URL=https://todoi.org
NODE_ENV=development

# TEMP(json-store): the site serves packages/db/seed/data.json and connects to no
# database; sign-in and the editor are off. The server ignores everything below
# for now. Uncomment when PostgreSQL returns: docs/json-store.md.
#
# DATABASE_URL=postgres://todoi:todoi@127.0.0.1:5434/todoi
# At least 32 characters. Signs nothing secret by itself; it keys the CSRF token derivation.
# SESSION_SECRET=change-me-change-me-change-me-change-me
#
# Only the parked PostgreSQL tests read this one (set it to run them: `pnpm test`).
# TEST_DATABASE_URL=postgres://todoi:todoi@127.0.0.1:5434/todoi_test
